# Copy to deploy/.env and edit. Never commit deploy/.env.
DOMAIN=pr.jemeel.dev
BASE_URL=https://pr.jemeel.dev
# Long random string, e.g. `openssl rand -hex 24`. Admin is disabled while this is unset or "change-me".
ADMIN_TOKEN=change-me

EVENT_NAME=DevFest Ilorin 2026
ORGANISER_NAME=Jemeel
ORGANISER_HANDLE=intellect4all
ORGANISER_SITE=https://jemeel.dev
ORGANISER_LINKEDIN=https://www.linkedin.com/in/abdul-jemeel-odewole-393a0b105/
WORKSHOP_TITLE=Observability for Distributed Systems
WORKSHOP_TIME=12:00 PM
WORKSHOP_ROOM=Room B
PASS_THRESHOLD=15
# Per-IP backstop (requests/min to /api/me, /api/runs, /api/merge). The whole venue shares one NAT IP.
IP_LIMIT=1200

# Backups: VACUUM INTO /backups every BACKUP_EVERY, keep BACKUP_KEEP files (288 = 24 h).
BACKUP_EVERY=5m
BACKUP_KEEP=288

# Optional off-site (offsite profile): rclone remote:path
RCLONE_DEST=
